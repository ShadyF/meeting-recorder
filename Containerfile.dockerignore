# Start with an empty context and allow only files used by Containerfile COPY.
**

# Keep VCS data, worktrees, tests, documentation, and development configuration out.
.git
.git/**
.slim
.slim/**
worktrees/
**/worktrees/**
tests/
tests/**
docs/
docs/**
.devcontainer/
.devcontainer/**
.github/
.github/**

# Keep generated caches and build artifacts out.
__pycache__/
**/__pycache__/**
.pytest_cache/
.pytest_cache/**
.mypy_cache/
.mypy_cache/**
build/
build/**
dist/
dist/**

# Allow the application source and the two container helpers.
!meeting_recorder/
!meeting_recorder/**
!container/
!container/meeting-recorder
!container/preflight.py

# Allow only the desktop entries and icons copied into the image.
!packaging/
!packaging/meeting-recorder.desktop
!packaging/meeting-recorder-settings.desktop
!packaging/meeting-recorder.svg
!packaging/meeting-recorder-recording.svg
!packaging/meeting-recorder-paused.svg

# Reassert generated-file exclusions after the source-directory allows.
**/__pycache__/
**/__pycache__/**
**/*.pyc
**/*.pyo
**/*.pyd
*.pyc
*.pyo
*.pyd
**/.pytest_cache/
**/.pytest_cache/**
**/.mypy_cache/
**/.mypy_cache/**
**/.cache/
**/.cache/**
**/*.egg-info/
**/*.egg-info/**
